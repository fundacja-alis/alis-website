# Set the final public domain before enabling indexing.
NEXT_PUBLIC_SITE_URL=https://fundacja-alis.pl
SITE_INDEXABLE=false

# Optional Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact form: server-only secrets, never NEXT_PUBLIC_
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
SUPABASE_SECRET_KEY=
# Alternatively, a legacy SUPABASE_SERVICE_ROLE_KEY can be used.
# Production origin (no trailing slash); use http://localhost:3000 locally.
CONTACT_ALLOWED_ORIGIN=https://fundacja-alis.pl
